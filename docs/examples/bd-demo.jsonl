# Blu-ray のデモ（トップメニュー、190 秒の本編にチャプター 3 つ・日本語字幕・LPCM 音声、MP4 から変換する「おまけ」、2 本を続けて再生するプレイリスト）。
# リポジトリのルートで実行する。素材は scripts/build-demo.ps1 が target/fixtures に作る。
{"command": "file.new", "params": {"kind": "bluRay", "standard": "ntsc"}}
{"command": "asset.import", "params": {"path": "target/fixtures/bd_long.m2v"}}
{"command": "asset.import", "params": {"path": "target/fixtures/bd_long.wav"}}
{"command": "asset.import", "params": {"path": "target/fixtures/h264_aac.mp4"}}
{"command": "asset.import", "params": {"path": "docs/examples/demo-ja.srt"}}
{"command": "timeline.create", "params": {"asset": 1, "name": "本編"}}
{"command": "timeline.addAudioTrack", "params": {"timeline": 5, "asset": 2, "language": "ja"}}
{"command": "timeline.addSubtitleTrack", "params": {"timeline": 5, "asset": 4, "language": "ja"}}
{"command": "timeline.addChapter", "params": {"timeline": 5, "timecode": "00:01:03;00", "name": "第2章"}}
{"command": "timeline.addChapter", "params": {"timeline": 5, "timecode": "00:02:07;00", "name": "第3章"}}
{"command": "timeline.create", "params": {"asset": 3, "name": "おまけ"}}
{"command": "playlist.create", "params": {"name": "続けて再生", "items": [5, 6]}}
{"command": "menu.create", "params": {"name": "トップメニュー"}}
{"command": "menu.addButton", "params": {"menu": 8, "label": "本編を再生", "target": {"timeline": 5}}}
{"command": "menu.addButton", "params": {"menu": 8, "label": "第2章から", "target": {"timeline": 5, "chapter": 1}}}
{"command": "menu.addButton", "params": {"menu": 8, "label": "第3章から", "target": {"timeline": 5, "chapter": 2}}}
{"command": "menu.addButton", "params": {"menu": 8, "label": "おまけ", "target": {"timeline": 6}}}
{"command": "menu.addButton", "params": {"menu": 8, "label": "続けて再生", "target": {"playlist": 7}}}
{"command": "timeline.setEndAction", "params": {"timeline": 5, "target": "lastMenu"}}
{"command": "timeline.setEndAction", "params": {"timeline": 6, "target": "lastMenu"}}
{"command": "playlist.setEndAction", "params": {"playlist": 7, "target": {"menu": 8}}}
{"command": "nav.setFirstPlay", "params": {"target": {"menu": 8}}}
{"command": "project.check"}
