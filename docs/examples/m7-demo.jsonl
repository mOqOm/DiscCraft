# M7 のデモ（2 つのタイトル、スライドショー、プレイリスト、モーションメニュー）。リポジトリのルートで実行する。素材の作り方は README の「試し方」。
{"command": "file.new", "params": {"kind": "dvd", "standard": "ntsc"}}
{"command": "asset.import", "params": {"path": "target/fixtures/h264_aac.mp4"}}
{"command": "asset.import", "params": {"path": "target/fixtures/ntsc.m2v"}}
{"command": "asset.import", "params": {"path": "target/fixtures/ntsc.ac3"}}
{"command": "asset.import", "params": {"path": "target/fixtures/slide1.png"}}
{"command": "asset.import", "params": {"path": "target/fixtures/slide2.png"}}
{"command": "asset.import", "params": {"path": "target/fixtures/slide3.png"}}
{"command": "timeline.create", "params": {"asset": 1, "name": "本編A"}}
{"command": "timeline.create", "params": {"asset": 2, "name": "本編B"}}
{"command": "timeline.addAudioTrack", "params": {"timeline": 8, "asset": 3, "language": "ja"}}
{"command": "slideshow.create", "params": {"name": "写真"}}
{"command": "slideshow.addSlide", "params": {"slideshow": 9, "asset": 4, "seconds": 2}}
{"command": "slideshow.addSlide", "params": {"slideshow": 9, "asset": 5, "seconds": 2}}
{"command": "slideshow.addSlide", "params": {"slideshow": 9, "asset": 6, "seconds": 2}}
{"command": "playlist.create", "params": {"name": "続けて再生", "items": [7, 8]}}
{"command": "menu.create", "params": {"name": "メイン"}}
{"command": "menu.setBackground", "params": {"menu": 11, "video": 1, "seconds": 4}}
{"command": "menu.addButton", "params": {"menu": 11, "label": "本編A", "target": {"timeline": 7}}}
{"command": "menu.addButton", "params": {"menu": 11, "label": "本編B", "target": {"timeline": 8}}}
{"command": "menu.addButton", "params": {"menu": 11, "label": "写真", "target": {"slideshow": 9}}}
{"command": "menu.addButton", "params": {"menu": 11, "label": "続けて再生", "target": {"playlist": 10}}}
{"command": "timeline.setEndAction", "params": {"timeline": 7, "target": "lastMenu"}}
{"command": "timeline.setEndAction", "params": {"timeline": 8, "target": "lastMenu"}}
{"command": "slideshow.setEndAction", "params": {"slideshow": 9, "target": "lastMenu"}}
{"command": "playlist.setEndAction", "params": {"playlist": 10, "target": {"menu": 11}}}
{"command": "nav.setFirstPlay", "params": {"target": {"menu": 11}}}
{"command": "project.check"}
