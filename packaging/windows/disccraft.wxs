<?xml version="1.0" encoding="UTF-8"?>
<!--
  DiscCraft's Windows installer (WiX Toolset 5). packaging/windows/package.ps1 builds it with
  -d BinDir=<the programs> -d RootDir=<the repository> -d MsiVersion=<a.b.c>.

  Installs for every user into Program Files\DiscCraft: disccraft.exe, disccraft-cli.exe and the documents, a
  Start menu shortcut, and opens .dcproj projects in DiscCraft. A later version replaces an earlier one (the
  UpgradeCode never changes).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DiscCraft" Manufacturer="mOqOm" Version="$(var.MsiVersion)"
           UpgradeCode="6B1C0FC9-4663-4960-A62C-F4123740D2C1" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of DiscCraft is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="DiscCraftIcon" SourceFile="$(var.RootDir)\assets\app-icon\disccraft.ico" />
    <Property Id="ARPPRODUCTICON" Value="DiscCraftIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mOqOm/DiscCraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="DiscCraft">
        <!-- The program, its icon and the projects it opens: one component with a fixed GUID (the programs carry
             no version resource, so WiX makes a GUID only for a component of a single file, as the ones below). -->
        <Component Id="Application" Guid="0E8D7E33-58F1-4C35-9C25-3A1B4D6F2E10">
          <File Id="DiscCraftExe" Source="$(var.BinDir)\disccraft.exe" KeyPath="yes" />
          <File Id="DiscCraftIco" Source="$(var.RootDir)\assets\app-icon\disccraft.ico" />
          <!-- Double-clicking a project opens it in DiscCraft. -->
          <ProgId Id="DiscCraft.Project" Description="DiscCraft project" Icon="DiscCraftIco">
            <Extension Id="dcproj" ContentType="application/x-disccraft-project">
              <Verb Id="open" TargetFile="DiscCraftExe" Argument="&quot;%1&quot;" />
            </Extension>
          </ProgId>
        </Component>
        <Component Id="CommandLine">
          <File Id="DiscCraftCliExe" Source="$(var.BinDir)\disccraft-cli.exe" KeyPath="yes" />
        </Component>
        <Component Id="ReadmeEn"><File Id="ReadmeEn" Source="$(var.RootDir)\README.md" KeyPath="yes" /></Component>
        <Component Id="ReadmeJa"><File Id="ReadmeJa" Source="$(var.RootDir)\README.ja.md" KeyPath="yes" /></Component>
        <Component Id="LicenseMit"><File Id="LicenseMit" Source="$(var.RootDir)\LICENSE-MIT" KeyPath="yes" /></Component>
        <Component Id="LicenseApache"><File Id="LicenseApache" Source="$(var.RootDir)\LICENSE-APACHE" KeyPath="yes" /></Component>
        <Component Id="Notice"><File Id="Notice" Source="$(var.RootDir)\NOTICE" KeyPath="yes" /></Component>
        <Component Id="Attribution"><File Id="Attribution" Source="$(var.RootDir)\ATTRIBUTION.md" KeyPath="yes" /></Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="DiscCraftShortcut" Name="DiscCraft" Description="DVD and Blu-ray authoring"
                  Target="[INSTALLFOLDER]disccraft.exe" WorkingDirectory="INSTALLFOLDER" Icon="DiscCraftIcon" />
        <!-- A shortcut's component is kept by a value under HKCU (ICE38 / ICE43). -->
        <RegistryValue Root="HKCU" Key="Software\mOqOm\DiscCraft" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="DiscCraft">
      <ComponentRef Id="Application" />
      <ComponentRef Id="CommandLine" />
      <ComponentRef Id="ReadmeEn" />
      <ComponentRef Id="ReadmeJa" />
      <ComponentRef Id="LicenseMit" />
      <ComponentRef Id="LicenseApache" />
      <ComponentRef Id="Notice" />
      <ComponentRef Id="Attribution" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
